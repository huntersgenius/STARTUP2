# --- app ---------------------------------------------------------------
ENVIRONMENT=dev
LOG_LEVEL=INFO
BUILD_SHA=dev

# --- storage -----------------------------------------------------------
DATABASE_URL=postgresql+psycopg://sihhat:sihhat@localhost:5432/sihhat
REDIS_URL=redis://localhost:6379/0

# --- security ----------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-key-change-me
# Generate with:  python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
# Losing this key makes every patient record unreadable. Back it up in a KMS,
# not in this file, for anything past local development.
PII_ENCRYPTION_KEY=ZGV2LW9ubHktaW5zZWN1cmUtcGlpLWtleS0zMmJ5dGU=
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14

# --- AI ----------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Ollama or vLLM endpoint on the clinic edge box; leave blank to disable.
LOCAL_LLM_BASE_URL=
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-sonnet-4-5
LOCAL_MODEL=llama3:8b
COST_CEILING_PER_CONSULTATION_USD=0.05
LATENCY_BUDGET_MS=6000

# --- observability -----------------------------------------------------
SENTRY_DSN=
METRICS_ENABLED=true
