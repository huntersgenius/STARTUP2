# Copy to .env and fill in. Every value must be unique per clinic.
#
# Generate the two keys on a laptop, not on the clinic box, and record them in
# the operations password manager. Losing PII_ENCRYPTION_KEY makes every
# patient record on this box permanently unreadable.

DB_PASSWORD=
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
PII_ENCRYPTION_KEY=

SIHHAT_VERSION=latest
LOCAL_MODEL=llama3:8b
